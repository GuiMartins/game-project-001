# Cache de importacao do Godot
.godot/
# Builds
export/
dist/
*.tmp
# Toolchain baixada por tools/dev.py: engine e zips da versao fixada.
# Cache de maquina, nao conteudo do projeto - a fonte da verdade e o
# .godot-version, que e versionado.
.dev/
# Relatorios XML/HTML do GdUnit4, gerados a cada rodada
reports/

# Bytecode do Python das ferramentas de tools/
__pycache__/

# Ajustes locais de agente/editor. O .claude/settings.json (sem .local) e
# versionado de proposito: e o contrato compartilhado.
.claude/settings.local.json

# Copia de seguranca que o Blender grava ao salvar por cima. O .blend daqui
# e regerado por arte/entregador.py, entao a copia nao guarda nada que o
# script nao refaca.
*.blend1
