; Engine configuration file.
; Prototipo "RushFood" - Road Rash com entregadores
; Ver docs/PROTOTIPO.md

config_version=5

[application]

config/name="RushFood - Prototipo"
; A pipeline le esta versao pra nomear a tag e a release. Bump aqui
; antes de merjar pra master; sem bump, a release e substituida.
config/version="0.1.0"
config/description="Prototipo greybox para validar os pilares: feel da moto, o corredor, combate lateral e o loop de entrega."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/controls.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; A janela abre maior que o viewport base. O viewport segue 1280x720 pra
; PIXEL_SHRINK=4 continuar dando 320x180 exato; o stretch canvas_items
; escala o resto. 320 -> 1920 e 6x inteiro, entao o pixel segue quadrado.
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; O painel de tuning e um no Window. Sem isto o Godot desenha subjanelas
; DENTRO da janela do jogo (embedded), que e exatamente o que a gente
; nao quer: o painel tapando o jogo que voce esta tentando ajustar.
window/subwindows/embed_subwindows=false

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/fsr_sharpness=0.0
; Exigido pra exportar macOS universal/arm64. Sem isto o export falha
; com "nao e possivel exportar para universal ou arm64". O custo e
; importar texturas tambem em ASTC - irrelevante num greybox.
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.13, 0.14, 0.2, 1)
