; Engine configuration file.
; Prototipo "RushFood" - Road Rash com entregadores
; Ver docs/PROTOTIPO.md

config_version=5

[application]

config/name="RushFood - Prototipo"
; Subir esta versao e o que publica: o merge na master de uma versao que
; ainda nao tem tag vira release. Use `python tools/dev.py versao patch`.
config/version="0.0.8"
config/description="Prototipo greybox para validar os pilares: feel da moto, o corredor, combate lateral e o loop de entrega."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Controls="*res://scripts/controls.gd"

[debug]

; 2 = ERRO, nao aviso. Todo o codigo ja e tipado, e aviso que ninguem le
; deixa de segurar nada: uma IA gera GDScript rapido e sem tipo, e o
; projeto perde o padrao sem ninguem notar. Aqui o build quebra na hora.
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; O viewport base e 1920x1080 pra que as duas resolucoes internas do jogo
; sejam divisao inteira dele: shrink 3 da 640x360 e shrink 2 da 960x540
; (scripts/main.gd, V30). Em 1080p e 4K os dois dao pixel inteiro.
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
; Fracionario de proposito. "integer" foi tentado e saiu: ele arredonda a
; escala sobre o viewport base, e nao sobre os 640x360 do mundo, entao a
; janela de 1280x720 (1,5x sobre o mundo) cairia para 1x e o jogo ocuparia
; metade dela.
; O preco do fracionario era pixel irregular (e tela tremendo com a camera
; andando) em janela fora do padrao; o scripts/ampliacao.gdshader paga esse
; preco. Em 1920 e 3840 a escala por pixel e inteira nas duas resolucoes.
window/stretch/scale_mode="fractional"
; O painel de tuning e um no Window. Sem isto o Godot desenha subjanelas
; DENTRO da janela do jogo (embedded), que e exatamente o que a gente
; nao quer: o painel tapando o jogo que voce esta tentando ajustar.
window/subwindows/embed_subwindows=false

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

; 16x, e nao o padrao de 4x: o chao e visto quase de lado, e nessa inclinacao
; a razao de anisotropia passa de 4 logo a frente da moto. Acima do limite o
; grao claro do asfalto deixa de ser media e vira ponto que acende e apaga.
textures/default_filters/anisotropic_filtering_level=4
textures/canvas_textures/default_texture_filter=0
; Sombra macia na qualidade maxima, e nao o padrao (baixa) nem a dura. A
; borda de sombra nao passa pelo MSAA (e sombreamento, nao geometria): dura,
; ela e mais fina que o pixel de 640x360 e serrilha andando com a camera. O
; PCF a alarga para ~1 pixel (o `shadow_blur` em `world.gd`), que e o
; antialiasing dela. Qualidade maxima porque o PCF do Godot gira as amostras
; por um ruido preso ao pixel da tela: com poucas amostras a penumbra vira
; chuvisco; com o maximo o ruido fica abaixo de um degrau da paleta.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
scaling_3d/fsr_sharpness=0.0
; Exigido pra exportar macOS universal/arm64. Sem isto o export falha
; com "nao e possivel exportar para universal ou arm64". O custo e
; importar texturas tambem em ASTC - irrelevante num greybox.
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.13, 0.14, 0.2, 1)

[shader_globals]

; Quanto ja escureceu, de 0 (meio-dia) a 1 (noite fechada): o `Hora.escuro`,
; posto pelo `Relogio`. Global para cada shader que acende alguma coisa de
; noite - farol, lanterna, janela - ler o mesmo numero sem ninguem varrer
; instancia por instancia.
noite={
"type": "float",
"value": 0.0
}
